rules_version = '2';

// Journal photos live under users/{uid}/... Each user can read and write only
// their own objects. Keep this in sync with journalPhotoPath() in lib/photos.ts.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
